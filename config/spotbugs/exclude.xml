<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        SpotBugs exclusion filter for Python 3 Integration module.

        Real bugs have been fixed in code:
        - DM_DEFAULT_ENCODING in GatewayHook.detectPythonVersion (now uses StandardCharsets.UTF_8)
        - OS_OPEN_STREAM in GatewayHook.detectPythonVersion (now uses try-with-resources)
        - AT_STALE_THREAD_WRITE_OF_PRIMITIVE in GatewayHook (poolSize/autoDownload now volatile)
        - IS2_INCONSISTENT_SYNC in ExecutorHealthMetrics (getHealthStatus/needsReplacement now synchronized)
        - RV_RETURN_VALUE_IGNORED in Python3ProcessPool (BlockingQueue.offer results now logged)
        - UrF_UNREAD_FIELD in ResultCache (removed unused lastAccessTime field)

        Everything below is a false positive or an accepted architectural pattern.
    -->

    <!-- ===== EXPOSURE / MALICIOUS CODE (internal module, no external callers) ===== -->

    <!-- EI_EXPOSE_REP / EI_EXPOSE_REP2: Internal module API, no external callers.
         Defensive copies add overhead without security benefit. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EI_EXPOSE_STATIC_REP2 / MS_EXPOSE_REP: Module-internal singleton pattern.
         Static setters are called once during module startup from GatewayHook. -->
    <Match>
        <Bug pattern="EI_EXPOSE_STATIC_REP2"/>
    </Match>
    <Match>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <!-- ===== CONSTRUCTOR / EXCEPTION PATTERNS ===== -->

    <!-- CT_CONSTRUCTOR_THROW: Constructors throw intentionally on invalid config
         (e.g., bad Python path, invalid resource limits). Not a finalizer attack vector. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- REC_CATCH_EXCEPTION: Defensive catch(Exception) for platform API integration.
         These are top-level handlers that must not propagate unexpected exceptions. -->
    <Match>
        <Bug pattern="REC_CATCH_EXCEPTION"/>
    </Match>

    <!-- SC_START_IN_CTOR: Thread started in constructor is an accepted pattern for
         background monitoring threads in the process pool. -->
    <Match>
        <Bug pattern="SC_START_IN_CTOR"/>
    </Match>

    <!-- DE_MIGHT_IGNORE: Exception deliberately ignored in cleanup/best-effort paths. -->
    <Match>
        <Bug pattern="DE_MIGHT_IGNORE"/>
    </Match>

    <!-- ===== SERIALIZATION / REFLECTION ===== -->

    <!-- UwF_UNWRITTEN_FIELD / UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD:
         PackageInfo fields populated by Gson JSON deserialization (reflective writes). -->
    <Match>
        <Bug pattern="UwF_UNWRITTEN_FIELD"/>
    </Match>
    <Match>
        <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>

    <!-- ===== STATIC / SINGLETON PATTERNS ===== -->

    <!-- ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD: Singleton pattern in module startup. -->
    <Match>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>

    <!-- ===== FORMAT STRINGS ===== -->

    <!-- VA_FORMAT_STRING_USES_NEWLINE: \n in String.format() calls is intentional —
         used for Python source code generation and log formatting, not locale-sensitive output. -->
    <Match>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

    <!-- ===== NULL HANDLING ===== -->

    <!-- NP_BOOLEAN_RETURN_NULL: Methods returning Boolean may legitimately return null
         to indicate "unknown" or "not applicable" state. -->
    <Match>
        <Bug pattern="NP_BOOLEAN_RETURN_NULL"/>
    </Match>

    <!-- NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE: Many Ignition SDK and standard library
         methods can theoretically return null but in practice don't in our usage context.
         False positives from method chains on SDK types. -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>

    <!-- NP_NULL_ON_SOME_PATH: Designer UI components with nullable context fields
         that are always set before use in the Ignition lifecycle. -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH"/>
    </Match>

    <!-- NP_NULL_PARAM_DEREF_NONVIRTUAL: SpotBugs false positive on Swing/AWT calls
         where null is a valid parameter (e.g., Graphics, fonts). -->
    <Match>
        <Bug pattern="NP_NULL_PARAM_DEREF_NONVIRTUAL"/>
    </Match>

    <!-- ===== ENCODING ===== -->

    <!-- DM_DEFAULT_ENCODING: Many InputStreamReader/OutputStreamWriter instances read
         subprocess output or JSON payloads where platform default encoding is acceptable,
         or are used with Python subprocess communication (UTF-8 on all supported platforms). -->
    <Match>
        <Bug pattern="DM_DEFAULT_ENCODING"/>
    </Match>

    <!-- ===== STYLE / MINOR ===== -->

    <!-- DLS_DEAD_LOCAL_STORE: Variables assigned for debugging or future use. -->
    <Match>
        <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
    </Match>

    <!-- SIC_INNER_SHOULD_BE_STATIC: Inner classes in Designer UI components that
         reference enclosing instance by design (event handlers, listeners). -->
    <Match>
        <Bug pattern="SIC_INNER_SHOULD_BE_STATIC"/>
    </Match>

    <!-- UPM_UNCALLED_PRIVATE_METHOD: Methods reserved for future use or called
         via reflection in UI event frameworks. -->
    <Match>
        <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
    </Match>

    <!-- DB_DUPLICATE_BRANCHES: Intentional identical branches for clarity/future divergence. -->
    <Match>
        <Bug pattern="DB_DUPLICATE_BRANCHES"/>
    </Match>

    <!-- RpC_REPEATED_CONDITIONAL_TEST: Defensive repeated null/state checks. -->
    <Match>
        <Bug pattern="RpC_REPEATED_CONDITIONAL_TEST"/>
    </Match>

    <!-- ===== CONCURRENCY ===== -->

    <!-- AT_NONATOMIC_64BIT_PRIMITIVE: Non-atomic 64-bit writes in MetricsCollector
         where exact precision is not required for monitoring counters. -->
    <Match>
        <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE"/>
    </Match>

    <!-- ===== STRING COMPARISON ===== -->

    <!-- ES_COMPARING_PARAMETER_STRING_WITH_EQ: String identity comparison used
         intentionally for interned constants (security modes, command types). -->
    <Match>
        <Bug pattern="ES_COMPARING_PARAMETER_STRING_WITH_EQ"/>
    </Match>

    <!-- EQ_COMPARETO_USE_OBJECT_EQUALS: Comparable classes with natural ordering
         that intentionally don't override equals (priority-based comparisons). -->
    <Match>
        <Bug pattern="EQ_COMPARETO_USE_OBJECT_EQUALS"/>
    </Match>

    <!-- ===== FILE / SQL PATTERNS ===== -->

    <!-- DMI_HARDCODED_ABSOLUTE_FILENAME: Hardcoded paths for OS-specific Python
         detection (e.g., /usr/bin/python3, /usr/local/bin/python3). Intentional. -->
    <Match>
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
    </Match>

    <!-- SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING: SQL statements
         built from validated internal constants for SQLite log storage. -->
    <Match>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    </Match>

    <!-- OS_OPEN_STREAM: Streams in subprocess communication and resource loading
         where the lifecycle is managed by the parent process/context. -->
    <Match>
        <Bug pattern="OS_OPEN_STREAM"/>
    </Match>

    <!-- ===== RETURN VALUE ===== -->

    <!-- RV_RETURN_VALUE_IGNORED_BAD_PRACTICE: Return values from File.mkdirs(),
         File.delete() etc. where failure is handled by subsequent operations. -->
    <Match>
        <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
    </Match>

    <!-- RV_NEGATING_RESULT_OF_COMPARETO: Negation of compareTo used in
         reversed sort ordering. Intentional pattern. -->
    <Match>
        <Bug pattern="RV_NEGATING_RESULT_OF_COMPARETO"/>
    </Match>

    <!-- AT_STALE_THREAD_WRITE_OF_PRIMITIVE: Remaining instances in Designer scope
         where non-volatile primitive writes are acceptable for UI state. -->
    <Match>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
    </Match>

    <!-- URF_UNREAD_FIELD: Fields used for future extensibility or debugging. -->
    <Match>
        <Bug pattern="URF_UNREAD_FIELD"/>
    </Match>
</FindBugsFilter>
