{
  "name": "python3-ide-ui",
  "version": "4.6.6",
  "private": true,
  "description": "React Web UI for Python 3 Integration Module (Ignition Gateway)",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "clean": "rimraf build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "codemirror": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lint": "^6.9.8",
    "lucide-react": "^1.79.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "css-loader": "^7.1.5",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1",
    "rimraf": "^6.1.4",
    "vitest": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/dom": "^10.4.2"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
