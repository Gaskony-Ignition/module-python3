#!/bin/bash

# Pre-commit hook for Python 3 Integration Module
# Runs automated checks before allowing commit

set -e

echo ""
echo "🔍 Running pre-commit checks..."
echo ""

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Track overall success
CHECKS_PASSED=true

# Function to run a check
run_check() {
    local check_name=$1
    local check_command=$2

    echo "→ ${check_name}..."

    if eval "$check_command" > /tmp/pre-commit-check.log 2>&1; then
        echo -e "  ${GREEN}✓${NC} ${check_name} passed"
        return 0
    else
        echo -e "  ${RED}✗${NC} ${check_name} failed"
        cat /tmp/pre-commit-check.log
        CHECKS_PASSED=false
        return 1
    fi
}

# 1. Check for Zone.Identifier files
echo ""
echo "=== File Cleanup Checks ==="
if run_check "Zone.Identifier files" "! find . -name '*Zone.Identifier*' -type f | grep -q ."; then
    :
else
    echo -e "  ${YELLOW}→ Run: find . -name '*Zone.Identifier*' -type f -delete${NC}"
fi

# 2. Check for temporary files in staged commits
TEMP_FILES=$(git diff --cached --name-only | grep -E '\.(tmp|bak|swp)$' || true)
if [ -n "$TEMP_FILES" ]; then
    echo -e "  ${RED}✗${NC} Temporary files found in staged commits:"
    echo "$TEMP_FILES"
    CHECKS_PASSED=false
else
    echo -e "  ${GREEN}✓${NC} No temporary files in commit"
fi

# 3. Documentation consistency check
echo ""
echo "=== Documentation Checks ==="
if [ -f "./scripts/check-docs.sh" ]; then
    if run_check "Documentation consistency" "./scripts/check-docs.sh"; then
        :
    else
        echo -e "  ${YELLOW}→ Fix documentation issues before committing${NC}"
    fi
else
    echo -e "  ${YELLOW}⚠${NC} Documentation check script not found (skipping)"
fi

# 4. Java compilation check (quick)
echo ""
echo "=== Compilation Checks ==="
cd python3-integration 2>/dev/null || true
if [ -f "./gradlew" ]; then
    if run_check "Java compilation" "./gradlew compileJava -x test --no-daemon -q"; then
        :
    else
        echo -e "  ${YELLOW}→ Fix compilation errors before committing${NC}"
    fi
    cd - > /dev/null
else
    echo -e "  ${YELLOW}⚠${NC} Gradle wrapper not found (skipping compilation check)"
fi

# 5. Test execution (optional - commented out for speed)
# Uncomment to run tests on every commit (slower)
# echo ""
# echo "=== Test Checks ==="
# cd python3-integration 2>/dev/null || true
# if [ -f "./gradlew" ]; then
#     if run_check "Unit tests" "./gradlew test --no-daemon -q"; then
#         :
#     else
#         echo -e "  ${YELLOW}→ Fix failing tests before committing${NC}"
#     fi
#     cd - > /dev/null
# fi

# 6. Check for debug statements
echo ""
echo "=== Code Quality Checks ==="
DEBUG_STATEMENTS=$(git diff --cached --name-only | grep '\.java$' | xargs grep -n 'System\.out\.println\|System\.err\.println' 2>/dev/null || true)
if [ -n "$DEBUG_STATEMENTS" ]; then
    echo -e "  ${YELLOW}⚠${NC} Debug print statements found (consider using logger):"
    echo "$DEBUG_STATEMENTS" | head -5
    if [ $(echo "$DEBUG_STATEMENTS" | wc -l) -gt 5 ]; then
        echo "  ... and $(($(echo "$DEBUG_STATEMENTS" | wc -l) - 5)) more"
    fi
else
    echo -e "  ${GREEN}✓${NC} No debug print statements found"
fi

# 7. Check for TODO/FIXME comments in staged files
TODO_COUNT=$(git diff --cached --name-only | grep '\.java$' | xargs grep -c 'TODO\|FIXME' 2>/dev/null | awk -F: '{sum+=$2} END {print sum}' || echo "0")
if [ "$TODO_COUNT" -gt 0 ]; then
    echo -e "  ${YELLOW}⚠${NC} $TODO_COUNT TODO/FIXME comment(s) found in staged files"
else
    echo -e "  ${GREEN}✓${NC} No TODO/FIXME comments in staged files"
fi

# Final result
echo ""
echo "=================================="
if [ "$CHECKS_PASSED" = true ]; then
    echo -e "${GREEN}✓ All pre-commit checks passed!${NC}"
    echo "=================================="
    echo ""
    exit 0
else
    echo -e "${RED}✗ Some pre-commit checks failed${NC}"
    echo "=================================="
    echo ""
    echo "Options:"
    echo "  1. Fix the issues and try again"
    echo "  2. Skip checks with: git commit --no-verify"
    echo ""
    exit 1
fi
